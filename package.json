{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js tests/e2e playwright.config.ts --max-warnings=0",
        "typecheck": "tsc --noEmit",
    "format": "prettier --write resources/js resources/css scripts playwright.config.ts tests/e2e",
    "format:check": "prettier --check resources/js resources/css scripts playwright.config.ts tests/e2e",
    "test:vite-cors": "node scripts/check-vite-cors.mjs",
    "e2e": "node scripts/prepare-e2e.mjs && npx --no-install playwright test",
        "test:integrations": "npm --prefix integrations/whatsapp-web test",
        "e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.6.1",
        "@inertiajs/vite": "^3.6.1",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-select": "^2.3.7",
        "@stripe/react-stripe-js": "^6.8.1",
        "@stripe/stripe-js": "^9.13.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "laravel-echo": "^2.4.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.31.0",
        "pusher-js": "^8.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-leaflet": "^5.0.0",
        "tailwind-merge": "^3.6.0"
    }
}
