APP_NAME="ISP Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_VERSION=1.0.0
MIN_SUPPORTED_APP_VERSION=1.0.0
APP_MAINTENANCE=false
# APP_MAINTENANCE_MESSAGE=
SECURITY_ENFORCE_TWO_FACTOR=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_SEND_DEFAULT_PII=false

MONITORING_ENABLED=false
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_SECRET=
MONITORING_ALERT_TIMEOUT=10
MONITORING_QUEUE_DEPTH_THRESHOLD=1000

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PROVIDER=cloud
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_ENDPOINT=http://whatsapp-web:3001
WHATSAPP_WEB_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_URL=
PAYMENT_GATEWAY=null
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_ENDPOINT=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_TIMEOUT=15
WHISH_ENABLED=false
WHISH_ENVIRONMENT=sandbox
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=
WHISH_ENDPOINT=
WHISH_TIMEOUT=15
WHISH_SUCCESS_CALLBACK_URL=
WHISH_FAILURE_CALLBACK_URL=
WHISH_SUCCESS_REDIRECT_URL=
WHISH_FAILURE_REDIRECT_URL=
FX_ROUNDING_MODE=half_up
FX_RATE_MAX_AGE_HOURS=72
FRANKFURTER_ENABLED=false
FRANKFURTER_ENDPOINT=https://api.frankfurter.dev
FRANKFURTER_TIMEOUT=10
FRANKFURTER_QUOTES=LBP,USD,EUR
REVERB_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Network adapter (external OSS/UISP/ACS webhook; leave blank when unused)
EXTERNAL_NETWORK_ENDPOINT=
EXTERNAL_NETWORK_TOKEN=
EXTERNAL_NETWORK_TIMEOUT=5

BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ENCRYPTION=default
BACKUP_VERIFY=true
BACKUP_NOTIFY_TO=
BACKUP_TRIES=3
BACKUP_RETRY_DELAY=60

VITE_APP_NAME="${APP_NAME}"
